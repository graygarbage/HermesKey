# HermesKey configuration
# The installed hotkey, Settings and services use ~/.config/hermeskey/hermeskey.env
# even when XDG_CONFIG_HOME is customized.

# faster-whisper model name
MODEL=medium

# Strict speech-model offline mode (0=download allowed, 1=cached/local models only).
# Enable after an explicit online model download or select a local model path.
# Disables model metadata checks/downloads at service startup; does not make
# bootstrap dependency/release downloads or clipboard history offline/private.
HERMESKEY_OFFLINE=0

# Python for the speech server (defaults to ~/venvs/stt/bin/python)
# PYTHON_STT=/path/to/venv/bin/python

# Spoken language. Set to empty for auto-detect.
STT_LANG=en

# Microphone source. "default" follows your desktop's default input device.
# To pin a specific mic, use a name from: pactl list short sources
RECORD_SOURCE=default

# Clipboard command for Wayland
CLIP_CMD=wl-copy

# type | clipboard. With ydotool, non-ASCII transcripts use clipboard paste
# when COPY_TO_CLIPBOARD=1; setting it to 0 disables both the backup and
# Unicode paste in type mode (you will be notified, but text is not inserted).
# The default backup may remain in KDE clipboard history or other sync tools.
# Settings > Input has a privacy-first typing choice (type mode, backup off).
INSERT_MODE=type
COPY_TO_CLIPBOARD=1

# auto | ydotool | wtype | xdotool
TYPE_BACKEND=auto

# Keep the last recording after transcription (for debugging). 0 = delete it.
# Recordings are stored in $XDG_RUNTIME_DIR, which only you can read.
KEEP_AUDIO=0

# Typing speed in ms (ydotool). Raise these if an app drops characters.
TYPE_KEY_DELAY=1
TYPE_KEY_HOLD=5

# UI
OVERLAY_ENABLED=1
SOUND_ENABLED=1
FOCUS_SAFE_MODE=0

# Soft tones
START_TONE_HZ=660
STOP_TONE_HZ=520
TONE_DURATION=0.035
TONE_VOLUME=0.20

# App-specific paste fallback
TERMINAL_APPS=org.wezfurlong.wezterm,org.kde.konsole,kitty,Alacritty,ghostty,foot,gnome-terminal,tilix,xfce4-terminal
PASTE_FOR_APPS=$TERMINAL_APPS
PASTE_SHORTCUT=auto
