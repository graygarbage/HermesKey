[Unit]
Description=HermesKey prewarmed faster-whisper server
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/hermeskey/hermeskey.env
Environment=PYTHONUNBUFFERED=1
# Server reads SOCK, MODEL and STT_LANG from EnvironmentFile; model IDs and
# private paths must not appear in the long-lived process command line.
ExecStart=/usr/bin/bash -lc 'exec "$${PYTHON_STT:-%h/venvs/stt/bin/python}" "%h/.local/bin/hermeskey-server.py"'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
