#!/usr/bin/env bash
set -euo pipefail
umask 077

# Open the same canonical file as Settings and the user services.
CONFIG_PATH="$HOME/.config/hermeskey/hermeskey.env"
CONFIG_DIR="$(dirname -- "$CONFIG_PATH")"
if [[ -L "$CONFIG_DIR" || -L "$CONFIG_PATH" ]]; then
  printf 'Refusing symlinked HermesKey config path; inspect it manually.\n' >&2
  exit 1
fi
mkdir -p "$CONFIG_DIR"
[[ -d "$CONFIG_DIR" && ! -L "$CONFIG_DIR" ]] || { printf 'Invalid HermesKey config directory.\n' >&2; exit 1; }
chmod 0700 "$CONFIG_DIR"
if [[ ! -e "$CONFIG_PATH" ]]; then
  : >"$CONFIG_PATH"
fi
[[ -f "$CONFIG_PATH" && ! -L "$CONFIG_PATH" ]] || { printf 'Invalid HermesKey config file.\n' >&2; exit 1; }
chmod 0600 "$CONFIG_PATH"

if command -v xdg-open >/dev/null 2>&1; then
  exec xdg-open "$CONFIG_PATH"
fi

printf '%s\n' "$CONFIG_PATH"
