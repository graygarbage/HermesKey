#!/usr/bin/env bash
set -euo pipefail

ok() { printf '✅ %s\n' "$*"; }
warn() { printf '⚠️  %s\n' "$*"; }
fail() { printf '❌ %s\n' "$*"; }
section() { printf '\n%s\n' "== $* =="; }
check_cmd() {
  local cmd="$1"
  if command -v "$cmd" >/dev/null 2>&1; then
    ok "$cmd found: $(command -v "$cmd")"
  else
    fail "$cmd not found"
  fi
}

section 'Environment'
printf 'XDG_SESSION_TYPE=%s\n' "${XDG_SESSION_TYPE:-}"
printf 'XDG_CURRENT_DESKTOP=%s\n' "${XDG_CURRENT_DESKTOP:-}"
printf 'XDG_RUNTIME_DIR=%s\n' "${XDG_RUNTIME_DIR:-}"

section 'Core commands'
for cmd in ffmpeg python3 wl-copy notify-send ydotool ydotoold pactl paplay; do
  check_cmd "$cmd"
done

section 'Python venv'
PYTHON_STT="$(
  CONFIG_FILE="${HERMESKEY_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/hermeskey/hermeskey.env}"
  # shellcheck disable=SC1090
  [[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE" >/dev/null 2>&1
  printf '%s' "${PYTHON_STT:-$HOME/venvs/stt/bin/python}"
)"
if [[ -x "$PYTHON_STT" ]]; then
  ok "venv python found: $PYTHON_STT"
  if "$PYTHON_STT" -c 'import faster_whisper' >/dev/null 2>&1; then
    ok 'faster-whisper is installed in the venv'
  else
    fail "faster-whisper is not installed for $PYTHON_STT"
  fi
else
  warn "venv python missing: $PYTHON_STT"
fi

section 'Overlay'
# The overlay runs under the system python3, not the venv.
if python3 -c 'import PySide6.QtWidgets' >/dev/null 2>&1; then
  ok 'system python3 can import PySide6 (overlay)'
else
  warn 'system python3 cannot import PySide6: install python3-pyside6 (Fedora), pyside6 (Arch), or python3-pyside6.qtwidgets (Debian/Ubuntu)'
fi

section 'Active window detection'
# Used for the terminal paste fallback and FOCUS_SAFE_MODE.
if ! command -v qdbus >/dev/null 2>&1 && ! command -v qdbus6 >/dev/null 2>&1 && ! command -v qdbus-qt6 >/dev/null 2>&1; then
  warn 'qdbus not found: active window detection unavailable (text is always typed)'
elif command -v kdotool >/dev/null 2>&1; then
  ok "using kdotool: $(command -v kdotool)"
elif python3 -c 'import dbus; from gi.repository import GLib' >/dev/null 2>&1; then
  ok 'using built-in KWin script (python3-dbus + GLib)'
else
  warn 'unavailable: install kdotool, or python3-dbus and python3-gobject (text is always typed)'
fi

section 'Services'
if systemctl --user is-active --quiet hermeskey.service; then
  ok 'hermeskey.service is active'
else
  warn 'hermeskey.service is not active'
fi

if systemctl --user is-active --quiet hermeskey-ydotoold.service; then
  ok 'hermeskey-ydotoold.service is active'
else
  warn 'hermeskey-ydotoold.service is not active'
fi

section 'Input device'
if [[ ! -e /dev/uinput ]]; then
  warn '/dev/uinput is missing: load the uinput module and check your distro configuration'
elif [[ ! -r /dev/uinput || ! -w /dev/uinput ]]; then
  warn '/dev/uinput is not accessible to this user: ydotoold cannot start; check your active seat and udev uaccess rules (see docs/TROUBLESHOOTING.md)'
else
  ok '/dev/uinput is accessible to this user'
fi

section 'Sockets'
if [[ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/hermeskey.sock" ]]; then
  ok "HermesKey socket present: ${XDG_RUNTIME_DIR:-/run/user/$UID}/hermeskey.sock"
else
  warn "HermesKey socket missing: ${XDG_RUNTIME_DIR:-/run/user/$UID}/hermeskey.sock"
fi

if [[ -S "/run/user/$UID/.ydotool_socket" ]]; then
  ok "ydotool socket present: /run/user/$UID/.ydotool_socket"
else
  warn 'ydotool socket missing: /run/user/'"$UID"'/.ydotool_socket'
fi

section 'Audio sources'
RECORD_SOURCE="$(
  CONFIG_FILE="${HERMESKEY_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/hermeskey/hermeskey.env}"
  # shellcheck disable=SC1090
  [[ -f "$CONFIG_FILE" ]] && source "$CONFIG_FILE" >/dev/null 2>&1
  printf '%s' "${RECORD_SOURCE:-default}"
)"
if command -v pactl >/dev/null 2>&1; then
  if [[ "$RECORD_SOURCE" == "default" ]]; then
    ok "RECORD_SOURCE=default (currently: $(pactl get-default-source 2>/dev/null || echo unknown))"
  elif pactl list short sources 2>/dev/null | cut -f2 | grep -qxF -- "$RECORD_SOURCE"; then
    ok "RECORD_SOURCE found: $RECORD_SOURCE"
  else
    warn "RECORD_SOURCE not found: $RECORD_SOURCE (PipeWire may silently fall back to the default mic)"
  fi
  pactl list short sources || true
fi

section 'Service snippets'
systemctl --user --no-pager --full status hermeskey.service 2>/dev/null | sed -n '1,20p' || true
systemctl --user --no-pager --full status hermeskey-ydotoold.service 2>/dev/null | sed -n '1,20p' || true

section 'Result'
ok 'Doctor run complete.'
printf 'If dictation still fails, include this output plus %s in your issue.\n' "${XDG_STATE_HOME:-$HOME/.local/state}/hermeskey/hermeskey.log"
