#!/usr/bin/env bash
set -euo pipefail

ok() { printf '✅ %s\n' "$*"; }
warn() { printf '⚠️  %s\n' "$*"; }
fail() { printf '❌ %s\n' "$*"; }
section() { printf '\n%s\n' "== $* =="; }
check_cmd() {
  local cmd="$1"
  if command -v "$cmd" >/dev/null 2>&1; then
    ok "$cmd found"
  else
    fail "$cmd not found"
  fi
}

# The installed hotkey, Settings and both user services share this file.
# HERMESKEY_CONFIG is only an explicit per-command diagnostic override.
CONFIG_FILE="${HERMESKEY_CONFIG:-$HOME/.config/hermeskey/hermeskey.env}"
CONFIG_ERRORS=0
if [[ -f "$CONFIG_FILE" ]]; then
  # HermesKey itself sources this user-owned shell configuration.
  # shellcheck disable=SC1090
  if ! source "$CONFIG_FILE" >/dev/null 2>&1; then
    fail "Could not load config; check your private config file"
    CONFIG_ERRORS=1
  fi
fi
# Diagnostic imports must honor the same local-only policy as the speech service.
export HF_HUB_DISABLE_TELEMETRY=1
if [[ "${HERMESKEY_OFFLINE:-0}" == "1" ]]; then
  export HF_HUB_OFFLINE=1
fi
PYTHON_STT="${PYTHON_STT:-$HOME/venvs/stt/bin/python}"
RECORD_SOURCE="${RECORD_SOURCE:-default}"

config_error() {
  fail "$*"
  CONFIG_ERRORS=1
}

validate_choice() {
  local name="$1" value="$2" choices="$3"
  if [[ " $choices " == *" $value "* ]]; then
    ok "$name=$value"
  else
    config_error "$name is invalid (choose: ${choices// /, })"
  fi
}

validate_config() {
  section 'Configuration'
  if [[ -f "$CONFIG_FILE" ]]; then
    ok 'Config file present'
  else
    warn 'Config file missing; using defaults'
  fi

  local model="${MODEL:-medium}" language="${STT_LANG-en}" lang_result
  case "$model" in
    tiny|tiny.en|base|base.en|small|small.en|medium|medium.en|large|large-v1|large-v2|large-v3|large-v3-turbo|turbo|distil-large-v2|distil-large-v3|distil-medium.en|distil-small.en)
      ok 'MODEL preset supported'
      ;;
    *)
      if [[ -d "$model" || "$model" == */* ]]; then
        warn 'MODEL is a custom path or Hugging Face ID; cannot verify it offline'
      else
        warn 'Unknown faster-whisper model alias (verify spelling or use a local path / Hugging Face ID)'
      fi
      ;;
  esac

  if [[ -z "$language" ]]; then
    ok 'STT_LANG= (automatic detection)'
  elif [[ ! "$language" =~ ^([a-z]{2}|haw|yue)$ ]]; then
    config_error 'Invalid STT_LANG (expected a Whisper language code or empty for auto-detect)'
  else
    # Use faster-whisper's actual supported codes when the configured venv is
    # present. haw and yue are valid three-letter exceptions to ISO-639-1.
    lang_result="$("$PYTHON_STT" - "$language" 2>/dev/null <<'PY'
import sys
from faster_whisper.tokenizer import _LANGUAGE_CODES
print('valid' if sys.argv[1] in _LANGUAGE_CODES else 'invalid')
PY
)" || lang_result=unavailable
    case "$lang_result" in
      valid) ok 'STT_LANG supported' ;;
      invalid) config_error "Unsupported STT_LANG (not in faster-whisper's language codes)" ;;
      *) warn 'STT_LANG has valid syntax, but could not be checked against faster-whisper (check PYTHON_STT)' ;;
    esac
  fi

  validate_choice INSERT_MODE "${INSERT_MODE:-type}" 'type clipboard'
  validate_choice TYPE_BACKEND "${TYPE_BACKEND:-auto}" 'auto ydotool wtype xdotool'
  validate_choice PASTE_SHORTCUT "${PASTE_SHORTCUT:-auto}" 'auto ctrl-v ctrl-shift-v shift-insert'
  local name value
  for name in HERMESKEY_OFFLINE COPY_TO_CLIPBOARD KEEP_AUDIO OVERLAY_ENABLED SOUND_ENABLED FOCUS_SAFE_MODE; do
    value="${!name:-}"
    # Offline mode, audio retention and focus safety default to 0.
    if [[ -z "$value" ]]; then
      case "$name" in
        HERMESKEY_OFFLINE|KEEP_AUDIO|FOCUS_SAFE_MODE) value=0 ;;
        *) value=1 ;;
      esac
    fi
    validate_choice "$name" "$value" '0 1'
  done
  for name in TYPE_KEY_DELAY TYPE_KEY_HOLD; do
    case "$name" in
      TYPE_KEY_DELAY) value="${TYPE_KEY_DELAY:-1}" ;;
      TYPE_KEY_HOLD) value="${TYPE_KEY_HOLD:-5}" ;;
    esac
    if [[ "$value" =~ ^[0-9]+$ ]]; then
      ok "$name=$value"
    else
      config_error "$name is invalid (expected a non-negative integer in milliseconds)"
    fi
  done
  for name in START_TONE_HZ STOP_TONE_HZ TONE_DURATION TONE_VOLUME; do
    case "$name" in
      START_TONE_HZ) value="${START_TONE_HZ:-660}" ;;
      STOP_TONE_HZ) value="${STOP_TONE_HZ:-520}" ;;
      TONE_DURATION) value="${TONE_DURATION:-0.035}" ;;
      TONE_VOLUME) value="${TONE_VOLUME:-0.20}" ;;
    esac
    if [[ "$value" =~ ^[0-9]+(\.[0-9]+)?$ ]]; then
      ok "$name=$value"
    else
      config_error "$name is invalid (expected a non-negative number)"
    fi
  done
}

case "${1:-}" in
  '') ;;
  --config-only) validate_config; exit "$CONFIG_ERRORS" ;;
  *) printf 'Usage: hermeskey-doctor [--config-only]\n' >&2; exit 2 ;;
esac

section 'Environment'
printf 'XDG_SESSION_TYPE=%s\n' "${XDG_SESSION_TYPE:-}"
printf 'XDG_CURRENT_DESKTOP=%s\n' "${XDG_CURRENT_DESKTOP:-}"
if [[ -n "${XDG_RUNTIME_DIR:-}" ]]; then
  ok 'XDG_RUNTIME_DIR set'
else
  warn 'XDG_RUNTIME_DIR unset (shared /tmp fallback may be unsafe)'
fi

validate_config

section 'Core commands'
for cmd in ffmpeg python3 wl-copy notify-send ydotool ydotoold pactl paplay; do
  check_cmd "$cmd"
done

section 'Python venv'
if [[ -x "$PYTHON_STT" ]]; then
  ok 'configured speech Python found'
  if "$PYTHON_STT" -c 'import faster_whisper' >/dev/null 2>&1; then
    ok 'faster-whisper is installed in the venv'
  else
    fail 'faster-whisper is not installed for configured speech Python'
  fi
else
  warn 'configured speech Python missing (check PYTHON_STT in your private config)'
fi

section 'Overlay'
# The overlay runs under the system python3, not the venv.
if python3 -c 'import PySide6.QtWidgets' >/dev/null 2>&1; then
  ok 'system python3 can import PySide6 (overlay)'
else
  warn 'system python3 cannot import PySide6: install python3-pyside6 (Fedora), pyside6 (Arch), or python3-pyside6.qtwidgets (Debian/Ubuntu)'
fi

section 'Active window detection'
# Used for the terminal paste fallback and FOCUS_SAFE_MODE.
if ! command -v qdbus >/dev/null 2>&1 && ! command -v qdbus6 >/dev/null 2>&1 && ! command -v qdbus-qt6 >/dev/null 2>&1; then
  warn 'qdbus not found: active window detection unavailable (text is always typed)'
elif command -v kdotool >/dev/null 2>&1; then
  ok 'using kdotool'
elif python3 -c 'import dbus; from gi.repository import GLib' >/dev/null 2>&1; then
  ok 'using built-in KWin script (python3-dbus + GLib)'
else
  warn 'unavailable: install kdotool, or python3-dbus and python3-gobject (text is always typed)'
fi

section 'Services'
if systemctl --user is-active --quiet hermeskey.service; then
  ok 'hermeskey.service is active'
else
  warn 'hermeskey.service is not active'
fi

if systemctl --user is-active --quiet hermeskey-ydotoold.service; then
  ok 'hermeskey-ydotoold.service is active'
else
  warn 'hermeskey-ydotoold.service is not active'
fi

section 'Input device'
if [[ ! -e /dev/uinput ]]; then
  warn '/dev/uinput is missing: load the uinput module and check your distro configuration'
elif [[ ! -r /dev/uinput || ! -w /dev/uinput ]]; then
  warn '/dev/uinput is not accessible to this user: ydotoold cannot start; check your active seat and udev uaccess rules (see docs/TROUBLESHOOTING.md)'
else
  ok '/dev/uinput is accessible to this user'
fi

section 'Sockets'
if [[ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/hermeskey.sock" ]]; then
  ok 'HermesKey socket present'
else
  warn 'HermesKey socket missing'
fi

if [[ -S "/run/user/$UID/.ydotool_socket" ]]; then
  ok 'ydotool socket present'
else
  warn 'ydotool socket missing'
fi

section 'Audio sources'
if command -v pactl >/dev/null 2>&1; then
  if [[ "$RECORD_SOURCE" == "default" ]]; then
    if pactl get-default-source >/dev/null 2>&1; then
      ok 'RECORD_SOURCE=default (desktop microphone selected)'
    else
      warn 'Could not determine the desktop default microphone'
    fi
  elif pactl list short sources 2>/dev/null | cut -f2 | grep -qxF -- "$RECORD_SOURCE"; then
    ok 'Configured RECORD_SOURCE found'
  else
    warn 'Configured RECORD_SOURCE not found (PipeWire may fall back to the default mic)'
  fi
fi

# `systemctl status` embeds arbitrary third-party journal lines (including
# request URLs). Doctor never includes raw service logs or command lines.

section 'Result'
if (( CONFIG_ERRORS )); then
  fail 'Doctor found invalid configuration; correct the settings above.'
else
  ok 'Doctor run complete.'
fi
printf 'Review this report before sharing. Raw logs, config values, audio and transcripts are not part of Doctor; inspect logs locally and redact before sharing.\n'
exit "$CONFIG_ERRORS"
