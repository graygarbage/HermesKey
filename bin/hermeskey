#!/usr/bin/env bash
set -euo pipefail

# Recordings, logs, and state files are private to the user.
umask 077

APP_NAME="HermesKey"
APP_ID="hermeskey"
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/$APP_ID"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/$APP_ID"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$APP_ID"
CONFIG_FILE="${HERMESKEY_CONFIG:-$CONFIG_DIR/hermeskey.env}"
VERSION_FILE="${HERMESKEY_VERSION_FILE:-$DATA_DIR/VERSION}"

if [[ -f "$CONFIG_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
  set +a
fi

PYTHON_STT_DEFAULT="${PYTHON_STT:-$HOME/venvs/stt/bin/python}"
SERVER_SCRIPT_DEFAULT="${SERVER_SCRIPT:-$SCRIPT_DIR/hermeskey-server.py}"
OVERLAY_SCRIPT_DEFAULT="${OVERLAY_SCRIPT:-$SCRIPT_DIR/hermeskey-overlay.py}"

MODEL="${MODEL:-medium}"
# Unset -> en; set but empty (STT_LANG=) -> auto-detect.
STT_LANG="${STT_LANG-en}"

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
WAV="${WAV:-$RUNTIME_DIR/hermeskey_audio.wav}"
KEEP_AUDIO="${KEEP_AUDIO:-0}"
STATE="${STATE:-$RUNTIME_DIR/hermeskey_recording.pid}"
OVERLAY_STATE="${OVERLAY_STATE:-$RUNTIME_DIR/hermeskey_overlay.pid}"
SOCK="${SOCK:-$RUNTIME_DIR/hermeskey.sock}"
SERVER_PID="${SERVER_PID:-$RUNTIME_DIR/hermeskey_server.pid}"
TARGET_STATE="${TARGET_STATE:-$RUNTIME_DIR/hermeskey_target.env}"
# Keep the lock in a private per-user directory, including when runtime falls back to /tmp.
TOGGLE_LOCK="$STATE_DIR/toggle.lock"

RECORD_SOURCE="${RECORD_SOURCE:-default}"
CLIP_CMD="${CLIP_CMD:-wl-copy}"
INSERT_MODE="${INSERT_MODE:-type}"
COPY_TO_CLIPBOARD="${COPY_TO_CLIPBOARD:-1}"
TYPE_BACKEND="${TYPE_BACKEND:-auto}"
YDOTOOL_SOCKET_PATH="${YDOTOOL_SOCKET_PATH:-}"
FOCUS_SAFE_MODE="${FOCUS_SAFE_MODE:-0}"
OVERLAY_ENABLED="${OVERLAY_ENABLED:-1}"
SOUND_ENABLED="${SOUND_ENABLED:-1}"
START_TONE_HZ="${START_TONE_HZ:-660}"
STOP_TONE_HZ="${STOP_TONE_HZ:-520}"
TONE_DURATION="${TONE_DURATION:-0.035}"
TONE_VOLUME="${TONE_VOLUME:-0.20}"
TERMINAL_APPS="${TERMINAL_APPS:-org.wezfurlong.wezterm,org.kde.konsole,kitty,Alacritty,ghostty,foot,gnome-terminal,tilix,xfce4-terminal}"
PASTE_FOR_APPS="${PASTE_FOR_APPS:-$TERMINAL_APPS}"
PASTE_SHORTCUT="${PASTE_SHORTCUT:-auto}"
# Typing speed (ms). ydotool's own default hold is 20 ms per key, which
# made a 166-character dictation take ~4 s. Raise these if an app drops keys.
TYPE_KEY_DELAY="${TYPE_KEY_DELAY:-1}"
TYPE_KEY_HOLD="${TYPE_KEY_HOLD:-5}"
[[ "$TYPE_KEY_DELAY" =~ ^[0-9]+$ ]] || TYPE_KEY_DELAY=1
[[ "$TYPE_KEY_HOLD" =~ ^[0-9]+$ ]] || TYPE_KEY_HOLD=5
PYTHON_STT="$PYTHON_STT_DEFAULT"
SERVER_SCRIPT="$SERVER_SCRIPT_DEFAULT"
OVERLAY_SCRIPT="$OVERLAY_SCRIPT_DEFAULT"

LOG="${LOG:-$STATE_DIR/hermeskey.log}"
SERVER_LOG="${SERVER_LOG:-$STATE_DIR/hermeskey-server.log}"
OVERLAY_LOG="${OVERLAY_LOG:-$STATE_DIR/hermeskey-overlay.log}"
VERSION="${HERMESKEY_VERSION:-}"
if [[ -z "$VERSION" && -r "$VERSION_FILE" ]]; then
  VERSION="$(tr -d '[:space:]' < "$VERSION_FILE")"
fi
if [[ -z "$VERSION" && -r "$SCRIPT_DIR/../VERSION" ]]; then
  VERSION="$(tr -d '[:space:]' < "$SCRIPT_DIR/../VERSION")"
fi
[[ -n "$VERSION" ]] || VERSION="dev"

mkdir -p "$(dirname -- "$LOG")" "$(dirname -- "$SERVER_LOG")" "$(dirname -- "$OVERLAY_LOG")"
touch "$LOG"

log() { echo "[$(date '+%F %T')] $*" | tee -a "$LOG"; }

usage() {
  cat <<EOF
$APP_NAME $VERSION

Usage:
  hermeskey             Toggle recording on/off
  hermeskey --doctor    Run HermesKey diagnostics
  hermeskey --status    Show runtime and service status
  hermeskey --version   Print version
  hermeskey --help      Show this help

Config file:
  $CONFIG_FILE
EOF
}

run_doctor() {
  if command -v hermeskey-doctor >/dev/null 2>&1; then
    exec hermeskey-doctor
  elif [[ -x "$SCRIPT_DIR/hermeskey-doctor" ]]; then
    exec "$SCRIPT_DIR/hermeskey-doctor"
  else
    printf 'hermeskey-doctor not found.\n' >&2
    exit 1
  fi
}

service_status_line() {
  local unit="$1"
  if systemctl --user is-active --quiet "$unit" 2>/dev/null; then
    printf 'active\n'
  elif systemctl --user is-enabled --quiet "$unit" 2>/dev/null; then
    printf 'installed (inactive)\n'
  else
    printf 'not enabled\n'
  fi
}

print_status() {
  cat <<EOF
$APP_NAME $VERSION

config:    $CONFIG_FILE
runtime:   $RUNTIME_DIR
socket:    $SOCK
recording: $( [[ -f "$STATE" ]] && printf yes || printf no )
model:     $MODEL
language:  ${STT_LANG:-auto}
backend:   $TYPE_BACKEND
insert:    $INSERT_MODE
server:    $(service_status_line hermeskey.service)
ydotoold:  $(service_status_line hermeskey-ydotoold.service)
EOF
}

play_tone() {
  local freq="$1"
  [[ "$SOUND_ENABLED" == "1" ]] || return 0

  if command -v paplay >/dev/null 2>&1; then
    (
      python3 - "$freq" "$TONE_DURATION" "$TONE_VOLUME" <<'PY' | paplay --raw --channels=1 --rate=44100 --format=s16le
import math
import struct
import sys

freq = float(sys.argv[1])
duration = float(sys.argv[2])
volume = float(sys.argv[3])
rate = 44100
amp = int(32767 * max(0.02, min(volume, 1.0)))
frames = max(1, int(rate * duration))
attack = max(1, int(rate * 0.008))
release = max(1, int(rate * 0.020))

buf = bytearray()
for i in range(frames):
    env_a = min(1.0, i / attack)
    env_r = min(1.0, (frames - i) / release)
    env = min(env_a, env_r)
    sample = int(math.sin(2 * math.pi * freq * i / rate) * amp * env)
    buf += struct.pack('<h', sample)

sys.stdout.buffer.write(buf)
PY
    ) >/dev/null 2>&1 &
    return 0
  fi

  if command -v canberra-gtk-play >/dev/null 2>&1; then
    canberra-gtk-play -i bell -d hermeskey >/dev/null 2>&1 &
  fi
}

qdbus_cmd() {
  local c
  for c in qdbus qdbus6 qdbus-qt6; do
    if command -v "$c" >/dev/null 2>&1; then
      printf '%s\n' "$c"
      return 0
    fi
  done
  return 1
}

# Print the KWin UUID of the focused window, or nothing if unavailable.
# Never uses org.kde.KWin.queryWindowInfo: that is KWin's interactive
# window picker (crosshair cursor, blocks until the user clicks).
active_window_uuid() {
  local uuid=""
  if command -v kdotool >/dev/null 2>&1; then
    uuid="$(timeout 2 kdotool getactivewindow 2>/dev/null | head -n1 || true)"
  else
    # Built-in fallback: run a tiny KWin script that reports
    # workspace.activeWindow back to us over D-Bus (same idea as kdotool).
    uuid="$(timeout 3 python3 - 2>/dev/null <<'PY' || true
import os, tempfile
import dbus, dbus.service, dbus.mainloop.glib
from gi.repository import GLib

dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
bus = dbus.SessionBus()
loop = GLib.MainLoop()
result = []
IFACE = "io.github.graygarbage.HermesKey.ActiveWindow"

class Receiver(dbus.service.Object):
    @dbus.service.method(IFACE, in_signature="s")
    def Done(self, uuid):
        result.append(str(uuid))
        loop.quit()

Receiver(bus, "/ActiveWindow")
fd, path = tempfile.mkstemp(suffix=".js", dir=os.environ.get("XDG_RUNTIME_DIR"))
with os.fdopen(fd, "w") as f:
    f.write(
        "const w = workspace.activeWindow || workspace.activeClient;\n"
        f'callDBus("{bus.get_unique_name()}", "/ActiveWindow", "{IFACE}", "Done",'
        ' w ? w.internalId.toString() : "");\n'
    )
scripting = bus.get_object("org.kde.KWin", "/Scripting")
try:
    sid = scripting.loadScript(path, dbus_interface="org.kde.kwin.Scripting")
    bus.get_object("org.kde.KWin", f"/Scripting/Script{sid}").run(
        dbus_interface="org.kde.kwin.Script")
    GLib.timeout_add(1000, loop.quit)
    loop.run()
finally:
    try:
        scripting.unloadScript(path, dbus_interface="org.kde.kwin.Scripting")
    finally:
        os.unlink(path)
print(result[0] if result else "")
PY
)"
  fi
  [[ "$uuid" =~ ^\{?[0-9a-fA-F-]{36}\}?$ ]] && printf '%s\n' "$uuid"
  return 0
}

query_active_app() {
  local prefix="${1:-APP_}"
  local window_info="" qdbus uuid
  if qdbus="$(qdbus_cmd)"; then
    uuid="$(active_window_uuid)"
    if [[ -n "$uuid" ]]; then
      window_info="$("$qdbus" org.kde.KWin /KWin org.kde.KWin.getWindowInfo "$uuid" 2>/dev/null || true)"
    fi
  fi
  printf '%s\n' "$window_info" | python3 -c '
import sys

prefix = sys.argv[1]
data = {}
for line in sys.stdin:
    line = line.rstrip("\n")
    if ": " not in line:
        continue
    key, value = line.split(": ", 1)
    if key in {"uuid", "desktopFile", "resourceClass", "caption", "pid"}:
        data[key] = value

mapping = {
    "uuid": "UUID",
    "desktopFile": "DESKTOP_FILE",
    "resourceClass": "RESOURCE_CLASS",
    "caption": "CAPTION",
    "pid": "PID",
}
for src, dest in mapping.items():
    # Raw KEY=value lines; parsed by read_app_vars, never eval/sourced.
    value = data.get(src, "").replace("\r", " ").replace("\n", " ")
    print(f"{prefix}{dest}={value}")
' "$prefix"
}

# Read KEY=value lines (from query_active_app) on stdin and assign only the
# known window-info variables for the given prefix. Values are treated as
# plain data, so window captions can never be executed as shell code.
read_app_vars() {
  local prefix="$1" line key value
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"
    value="${line#*=}"
    case "$key" in
      "${prefix}UUID"|"${prefix}DESKTOP_FILE"|"${prefix}RESOURCE_CLASS"|"${prefix}CAPTION"|"${prefix}PID")
        printf -v "$key" '%s' "$value"
        ;;
    esac
  done
}

capture_target_app() {
  # Focus safety only needs the UUID and desktop file. Do not retain window
  # captions (which can contain document titles or user-entered text).
  query_active_app TARGET_ | grep -E '^TARGET_(UUID|DESKTOP_FILE)=' >"$TARGET_STATE"
  log "Target window captured for focus safety"
}

load_target_app() {
  TARGET_UUID=""
  TARGET_DESKTOP_FILE=""
  if [[ -f "$TARGET_STATE" ]]; then
    read_app_vars TARGET_ <"$TARGET_STATE"
  fi
}

load_current_app() {
  CURRENT_UUID=""
  CURRENT_DESKTOP_FILE=""
  CURRENT_RESOURCE_CLASS=""
  CURRENT_CAPTION=""
  read_app_vars CURRENT_ < <(query_active_app CURRENT_)
}

app_matches_patterns() {
  local patterns="$1"
  local desktop_file="$2"
  local resource_class="$3"
  local caption="$4"
  [[ -n "$patterns" ]] || return 1

  # A window caption can contain private document names or user text. Never
  # expose it (or custom patterns) through a subprocess command line.
  printf '%s\0' "$patterns" "$desktop_file" "$resource_class" "$caption" | python3 -c '
import re
import sys

fields = sys.stdin.buffer.read().split(b"\0")
if len(fields) != 5 or fields[-1]:
    raise SystemExit(1)
patterns = [p.strip() for p in fields[0].decode("utf-8", errors="replace").split(",") if p.strip()]
hay = "\n".join(field.decode("utf-8", errors="replace") for field in fields[1:4])
for pattern in patterns:
    if re.search(pattern, hay, flags=re.IGNORECASE):
        raise SystemExit(0)
raise SystemExit(1)
'
}

choose_paste_shortcut() {
  local desktop_file="$1"
  local resource_class="$2"
  local caption="$3"

  if [[ "$PASTE_SHORTCUT" != "auto" ]]; then
    echo "$PASTE_SHORTCUT"
    return 0
  fi

  if app_matches_patterns "$TERMINAL_APPS" "$desktop_file" "$resource_class" "$caption"; then
    echo ctrl-shift-v
  else
    echo ctrl-v
  fi
}

focus_is_safe() {
  [[ "$FOCUS_SAFE_MODE" == "1" ]] || return 0

  load_target_app

  if [[ -z "$TARGET_UUID" || -z "$CURRENT_UUID" ]]; then
    return 0
  fi

  if [[ "$TARGET_UUID" == "$CURRENT_UUID" ]]; then
    return 0
  fi

  log "Focus changed: target=${TARGET_DESKTOP_FILE:-?}/${TARGET_UUID:-?} current=${CURRENT_DESKTOP_FILE:-?}/${CURRENT_UUID:-?}"
  return 1
}

hide_overlay() {
  [[ "$OVERLAY_ENABLED" == "1" ]] || return 0
  if [[ -f "$OVERLAY_STATE" ]]; then
    local pid
    pid="$(cat "$OVERLAY_STATE" 2>/dev/null || true)"
    if [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null; then
      kill "$pid" 2>/dev/null || true
    fi
    rm -f "$OVERLAY_STATE"
  fi
}

show_overlay() {
  [[ "$OVERLAY_ENABLED" == "1" ]] || return 0
  local mode="$1"
  hide_overlay
  nohup python3 "$OVERLAY_SCRIPT" "$mode" >>"$OVERLAY_LOG" 2>&1 &
  echo $! >"$OVERLAY_STATE"
}

server_ping() {
  printf '%s\n' '{"cmd":"ping"}' | nc -U "$SOCK" -w 1 >/dev/null 2>&1
}

detect_type_backend() {
  if [[ "$TYPE_BACKEND" != "auto" ]]; then
    echo "$TYPE_BACKEND"
    return 0
  fi

  if command -v ydotool >/dev/null 2>&1 || [[ -x /usr/bin/ydotool ]]; then
    echo ydotool
    return 0
  fi
  if command -v wtype >/dev/null 2>&1 || [[ -x /usr/bin/wtype ]]; then
    echo wtype
    return 0
  fi
  if command -v xdotool >/dev/null 2>&1 || [[ -x /usr/bin/xdotool ]]; then
    echo xdotool
    return 0
  fi

  echo none
}

# ydotool emits keyboard events, not Unicode text. On KDE Wayland it can
# return success while dropping accents and entire non-Latin scripts. Check
# bytes in the C locale; printable ASCII is the only safe direct-type subset.
needs_unicode_paste() (
  LC_ALL=C
  [[ "$1" == *[!\ -\~]* ]]
)

COPIED=0

copy_text() {
  local text="$1"
  [[ "$COPIED" == "1" ]] && return 0
  if ! printf '%s' "$text" | "$CLIP_CMD"; then
    log "Clipboard copy command failed."
    return 1
  fi
  COPIED=1
  log "Copied transcription to clipboard (${#text} chars)."
}

resolve_ydotool_socket() {
  # Never auto-select a socket in a shared directory. Even explicit overrides
  # must stay in the user's private runtime directory: the socket accepts
  # virtual keyboard events, including dictated text.
  local runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}" ysock mode
  runtime_dir="${runtime_dir%/}"
  [[ "$runtime_dir" == /* && -d "$runtime_dir" && ! -L "$runtime_dir" ]] || return 1
  [[ "$(stat -c %u -- "$runtime_dir" 2>/dev/null)" == "$UID" ]] || return 1
  mode="$(stat -c %a -- "$runtime_dir" 2>/dev/null)" || return 1
  [[ "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
  (( (8#$mode & 077) == 0 )) || return 1

  ysock="${YDOTOOL_SOCKET_PATH:-${YDOTOOL_SOCKET:-$runtime_dir/.ydotool_socket}}"
  [[ "${ysock%/*}" == "$runtime_dir" && -S "$ysock" && ! -L "$ysock" ]] || return 1
  [[ "$(stat -c %u -- "$ysock" 2>/dev/null)" == "$UID" ]] || return 1
  mode="$(stat -c %a -- "$ysock" 2>/dev/null)" || return 1
  [[ "$mode" =~ ^[0-7]{3,4}$ ]] || return 1
  (( (8#$mode & 077) == 0 )) || return 1
  printf '%s\n' "$ysock"
}

type_text() {
  local text="$1"
  local backend ydotool_bin wtype_bin xdotool_bin ysock type_help
  backend="$(detect_type_backend)"
  ydotool_bin="$(command -v ydotool 2>/dev/null || true)"
  wtype_bin="$(command -v wtype 2>/dev/null || true)"
  xdotool_bin="$(command -v xdotool 2>/dev/null || true)"
  [[ -n "$ydotool_bin" ]] || ydotool_bin=/usr/bin/ydotool
  [[ -n "$wtype_bin" ]] || wtype_bin=/usr/bin/wtype
  [[ -n "$xdotool_bin" ]] || xdotool_bin=/usr/bin/xdotool

  case "$backend" in
    ydotool)
      if ! ysock="$(resolve_ydotool_socket)"; then
        log "Trusted ydotool socket unavailable; refusing typing."
        return 8
      fi
      if [[ ! -S "$ysock" ]]; then
        log "ydotool socket disappeared before typing"
        return 4
      fi
      type_help="$("$ydotool_bin" type --help 2>&1 || true)"
      # Old versions without --file cannot be given dictated text safely.
      [[ "$type_help" == *--file* ]] || return 7
      local timing=(--key-delay "$TYPE_KEY_DELAY")
      # --key-hold exists in ydotool >= 1.0 only (Debian/Ubuntu ship 0.1.x).
      if [[ "$type_help" == *--key-hold* ]]; then
        timing+=(--key-hold "$TYPE_KEY_HOLD")
      fi
      printf '%s' "$text" | YDOTOOL_SOCKET="$ysock" "$ydotool_bin" type "${timing[@]}" --file=-
      ;;
    wtype)
      printf '%s' "$text" | "$wtype_bin" -
      ;;
    xdotool)
      printf '%s' "$text" | "$xdotool_bin" type --clearmodifiers --delay "$TYPE_KEY_DELAY" --file -
      ;;
    none)
      return 2
      ;;
    *)
      log "Unknown TYPE_BACKEND: $backend"
      return 3
      ;;
  esac
}

paste_text() {
  local desktop_file="$1"
  local resource_class="$2"
  local caption="$3"
  local backend shortcut ydotool_bin xdotool_bin ysock
  backend="$(detect_type_backend)"
  shortcut="$(choose_paste_shortcut "$desktop_file" "$resource_class" "$caption")"
  ydotool_bin="$(command -v ydotool 2>/dev/null || true)"
  xdotool_bin="$(command -v xdotool 2>/dev/null || true)"
  [[ -n "$ydotool_bin" ]] || ydotool_bin=/usr/bin/ydotool
  [[ -n "$xdotool_bin" ]] || xdotool_bin=/usr/bin/xdotool

  case "$backend" in
    ydotool)
      if ! ysock="$(resolve_ydotool_socket)"; then
        log "Trusted ydotool socket unavailable; refusing paste."
        return 8
      fi
      if [[ ! -S "$ysock" ]]; then
        log "ydotool socket disappeared before paste"
        return 4
      fi
      case "$shortcut" in
        ctrl-v)
          YDOTOOL_SOCKET="$ysock" "$ydotool_bin" key 29:1 47:1 47:0 29:0
          ;;
        ctrl-shift-v)
          YDOTOOL_SOCKET="$ysock" "$ydotool_bin" key 29:1 42:1 47:1 47:0 42:0 29:0
          ;;
        shift-insert)
          YDOTOOL_SOCKET="$ysock" "$ydotool_bin" key 42:1 110:1 110:0 42:0
          ;;
        *)
          log "Unknown paste shortcut: $shortcut"
          return 5
          ;;
      esac
      ;;
    xdotool)
      case "$shortcut" in
        ctrl-v) "$xdotool_bin" key --clearmodifiers ctrl+v ;;
        ctrl-shift-v) "$xdotool_bin" key --clearmodifiers ctrl+shift+v ;;
        shift-insert) "$xdotool_bin" key --clearmodifiers Shift+Insert ;;
        *) log "Unknown paste shortcut: $shortcut"; return 5 ;;
      esac
      ;;
    *)
      return 6
      ;;
  esac
}

insert_text() {
  local text="$1"
  local rc=0 unicode_paste=0 backend copy_ok=1

  # COPY_TO_CLIPBOARD=1 allows a backup and paste. Clipboard-only mode is
  # explicit consent to copy regardless of the backup preference.
  if [[ "$COPY_TO_CLIPBOARD" == "1" || "$INSERT_MODE" != "type" ]]; then
    copy_text "$text" || copy_ok=0
  fi

  if [[ "$INSERT_MODE" != "type" ]]; then
    if (( copy_ok )); then
      echo "Copied to clipboard."
    else
      log "Clipboard copy failed; no text inserted or copied."
      notify-send "$APP_NAME" "Clipboard copy failed. No transcript inserted or copied." || true
      echo "Clipboard copy failed."
    fi
    return 0
  fi

  backend="$(detect_type_backend)"
  if [[ "$backend" == "ydotool" ]] && needs_unicode_paste "$text"; then
    unicode_paste=1
    if [[ "$COPY_TO_CLIPBOARD" != "1" || "$copy_ok" != "1" ]]; then
      log "Unicode transcript not inserted: clipboard backup disabled or failed."
      notify-send "$APP_NAME" "Unicode typing needs clipboard paste. Enable/repair clipboard backup; no text was inserted or copied." || true
      echo "Unicode text not inserted or copied (clipboard unavailable)."
      return 0
    fi
  fi

  sleep 0.12

  # Look up the focused window once: it's where the keystrokes will go, so
  # it decides paste-vs-type and is compared with the recording target.
  local want_paste=0
  if [[ "$COPY_TO_CLIPBOARD" == "1" && -n "$PASTE_FOR_APPS" || "$unicode_paste" == "1" ]]; then
    want_paste=1
  fi
  CURRENT_UUID="" CURRENT_DESKTOP_FILE="" CURRENT_RESOURCE_CLASS="" CURRENT_CAPTION=""
  if [[ "$FOCUS_SAFE_MODE" == "1" || "$want_paste" == "1" ]]; then
    load_current_app
    log "Active app: ${CURRENT_DESKTOP_FILE:-?} | ${CURRENT_RESOURCE_CLASS:-?}"
  fi

  if ! focus_is_safe; then
    if [[ "$COPY_TO_CLIPBOARD" == "1" && "$copy_ok" == "1" ]]; then
      notify-send "$APP_NAME" "Focus changed. Transcript copied to clipboard only." || true
      echo "Copied to clipboard (focus changed)."
    else
      log "Focus changed; transcript not inserted or copied (clipboard unavailable)."
      notify-send "$APP_NAME" "Focus changed. No text inserted or copied (clipboard unavailable)." || true
      echo "Not inserted or copied (focus changed)."
    fi
    return 0
  fi

  if (( unicode_paste )); then
    # When the active app cannot be identified, auto-selecting Ctrl+V vs
    # Ctrl+Shift+V is unsafe (especially in terminals). Keep the backup for
    # manual paste instead. An explicit shortcut is the user's choice.
    if [[ "$PASTE_SHORTCUT" == "auto" && -z "$CURRENT_DESKTOP_FILE" && -z "$CURRENT_RESOURCE_CLASS" ]]; then
      log "Unicode transcript copied; active app unknown, paste shortcut not sent."
      notify-send "$APP_NAME" "Unicode transcript copied. Paste manually into your app." || true
      echo "Copied to clipboard (paste target unknown)."
      return 0
    fi
    paste_text "$CURRENT_DESKTOP_FILE" "$CURRENT_RESOURCE_CLASS" "$CURRENT_CAPTION" || rc=$?
    if (( rc == 0 )); then
      log "Sent Unicode paste shortcut (${#text} chars); transcript backed up on clipboard."
      echo "Paste shortcut sent; transcript on clipboard."
    else
      log "Unicode paste shortcut unavailable (code $rc); transcript backed up on clipboard."
      notify-send "$APP_NAME" "Could not paste Unicode transcript. It is on the clipboard; paste manually." || true
      echo "Copied to clipboard (paste shortcut failed)."
    fi
    return 0
  fi

  # Never paste whatever was previously on the clipboard if backing up the
  # current transcript failed. Printable ASCII can still be typed directly.
  if (( ! copy_ok )); then
    want_paste=0
  fi

  # Capture the backend's exit code directly; `rc=$?` after an if/fi block
  # would always read 0 and hide the real failure reason.
  # Pasting needs the transcript on the clipboard; with COPY_TO_CLIPBOARD=0
  # type instead of pasting whatever else happens to be there.
  if [[ "$want_paste" == "1" ]] && app_matches_patterns "$PASTE_FOR_APPS" "$CURRENT_DESKTOP_FILE" "$CURRENT_RESOURCE_CLASS" "$CURRENT_CAPTION"; then
    paste_text "$CURRENT_DESKTOP_FILE" "$CURRENT_RESOURCE_CLASS" "$CURRENT_CAPTION" || rc=$?
    if (( rc == 0 )); then
      log "Pasted transcription into active app (${#text} chars)."
      echo "Pasted into active app."
      return 0
    fi
  else
    type_text "$text" || rc=$?
    if (( rc == 0 )); then
      log "Typed transcription into active app (${#text} chars)."
      if (( ! copy_ok )); then
        notify-send "$APP_NAME" "Text was typed, but clipboard backup failed." || true
        echo "Typed into active app (clipboard backup failed)."
      else
        echo "Typed into active app."
      fi
      return 0
    fi
  fi

  # With clipboard backup disabled, never copy behind the user's back.
  if [[ "$COPY_TO_CLIPBOARD" != "1" ]]; then
    if (( rc == 7 )); then
      log "Typing backend cannot accept private input safely; no text inserted or copied."
      notify-send "$APP_NAME" "Typing backend cannot accept private text safely. Nothing inserted or copied." || true
    elif (( rc == 8 )); then
      log "Typing daemon socket unavailable or untrusted; no text inserted or copied."
      notify-send "$APP_NAME" "Typing daemon socket unavailable or untrusted. Nothing inserted or copied." || true
    else
      log "Insertion failed (code $rc); clipboard backup disabled, no text copied."
      notify-send "$APP_NAME" "Typing failed; no text copied (clipboard backup disabled)." || true
    fi
    echo "Not inserted or copied (typing failed)."
    return 0
  fi

  if (( ! copy_ok )); then
    log "Typing failed (code $rc); clipboard backup also failed."
    notify-send "$APP_NAME" "Typing and clipboard backup failed. No transcript inserted or copied." || true
    echo "Typing and clipboard backup failed."
    return 0
  fi

  # Insertion failed; the transcript is already backed up on the clipboard.
  case "$rc" in
    4)
      log "ydotool is installed but ydotoold is not running."
      notify-send "$APP_NAME" "ydotool is installed, but ydotoold is not running." || true
      echo "Copied to clipboard (ydotoold not running)."
      ;;
    5|6)
      log "Paste fallback is not available for this backend."
      notify-send "$APP_NAME" "Paste fallback unavailable for this typing backend." || true
      echo "Copied to clipboard (paste fallback unavailable)."
      ;;
    7)
      log "Typing backend cannot accept private input safely; transcript on clipboard."
      notify-send "$APP_NAME" "Typing backend cannot accept private text safely. Paste from clipboard manually." || true
      echo "Copied to clipboard (backend lacks private input)."
      ;;
    8)
      log "Typing daemon socket unavailable or untrusted; transcript on clipboard."
      notify-send "$APP_NAME" "Typing daemon socket unavailable or untrusted. Paste from clipboard manually." || true
      echo "Copied to clipboard (typing socket unavailable or untrusted)."
      ;;
    2|3)
      log "No supported typing backend found for active app insertion."
      notify-send "$APP_NAME" "No typing backend found. Install ydotool, wtype, or xdotool." || true
      echo "Copied to clipboard (typing backend missing)."
      ;;
    *)
      log "Active app insertion failed with code $rc."
      notify-send "$APP_NAME" "Typing failed. Transcript copied to clipboard." || true
      echo "Copied to clipboard (typing failed)."
      ;;
  esac
  return 0
}

# True if the server we started ourselves earlier is still alive (loading).
own_server_alive() {
  local pid
  [[ -f "$SERVER_PID" ]] || return 1
  pid="$(cat "$SERVER_PID" 2>/dev/null || true)"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null || return 1
  tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q 'hermeskey-server'
}

service_running() {
  case "$(systemctl --user is-active hermeskey.service 2>/dev/null || true)" in
    active|activating|reloading) return 0 ;;
    *) return 1 ;;
  esac
}

ensure_server() {
  if server_ping; then
    return 0
  fi

  # The server only listens once the model is loaded. If one is already
  # running but not answering yet, wait for it: starting another would load
  # a second copy of the model and orphan one of them.
  local waiting_for=""
  if service_running; then
    waiting_for="hermeskey.service"
  elif own_server_alive; then
    waiting_for="STT server pid $(cat "$SERVER_PID")"
  fi

  if [[ -n "$waiting_for" ]]; then
    log "Speech model still loading in $waiting_for; waiting"
    notify-send "$APP_NAME" "Speech model is still loading…" || true
  else
    rm -f "$SOCK"
    log "Starting STT server"
    SOCK="$SOCK" MODEL="$MODEL" STT_LANG="$STT_LANG" \
      nohup "$PYTHON_STT" "$SERVER_SCRIPT" >>"$SERVER_LOG" 2>&1 &
    echo $! >"$SERVER_PID"
  fi

  for _ in {1..120}; do
    if server_ping; then
      log "STT server ready"
      return 0
    fi
    sleep 0.25
  done

  if service_running || own_server_alive; then
    log "STT server is still loading the model"
    notify-send "$APP_NAME" "Speech model is still loading. Try again in a moment." || true
    return 1
  fi

  log "STT server failed to start"
  notify-send "$APP_NAME" "Speech model failed to start" || true
  return 1
}

record_start() {
  rm -f "$WAV" 2>/dev/null || true

  ensure_server
  if [[ "$FOCUS_SAFE_MODE" == "1" ]]; then
    capture_target_app
  fi
  play_tone "$START_TONE_HZ"
  show_overlay recording

  log "Starting recording from: $RECORD_SOURCE -> $WAV"
  ffmpeg -y \
    -f pulse -i "$RECORD_SOURCE" \
    -ac 1 -ar 16000 \
    -loglevel error \
    "$WAV" &
  echo $! >"$STATE"
  log "ffmpeg pid: $(cat "$STATE")"
}

request_transcription() {
  REQUEST_WAV="$WAV" REQUEST_LANG="$STT_LANG" REQUEST_SOCK="$SOCK" python3 - <<'PY'
import json
import os
import socket

sock_path = os.environ["REQUEST_SOCK"]
request = {
    "cmd": "transcribe",
    "wav": os.environ["REQUEST_WAV"],
    "language": os.environ["REQUEST_LANG"],
}

with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
    client.connect(sock_path)
    client.sendall((json.dumps(request, ensure_ascii=False) + "\n").encode("utf-8"))
    chunks = []
    while True:
        chunk = client.recv(65536)
        if not chunk:
            break
        chunks.append(chunk)

print(b"".join(chunks).decode("utf-8"), end="")
PY
}

extract_text() {
  python3 -c '
import json, sys
raw = sys.stdin.read().strip()
if not raw:
    sys.exit(2)
reply = json.loads(raw)
if reply.get("status") != "ok":
    print(reply.get("error", "transcription failed"), file=sys.stderr)
    sys.exit(1)
print(reply.get("text", ""), end="")
'
}

# Delete the recording once the server has processed it, so voice audio
# does not linger on disk. Set KEEP_AUDIO=1 to keep it for debugging.
discard_audio() {
  [[ "$KEEP_AUDIO" == "1" ]] && return 0
  rm -f "$WAV" 2>/dev/null || true
}

record_stop_and_transcribe() {
  if [[ ! -f "$STATE" ]]; then
    echo "Not recording."
    log "Stop requested but no $STATE found"
    hide_overlay
    return
  fi

  local pid
  pid="$(cat "$STATE")"
  log "Stopping ffmpeg pid: $pid"

  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    for _ in {1..40}; do
      if ! kill -0 "$pid" 2>/dev/null; then
        break
      fi
      sleep 0.05
    done
  fi
  rm -f "$STATE"
  play_tone "$STOP_TONE_HZ"

  for _ in {1..40}; do
    if [[ -s "$WAV" ]]; then
      break
    fi
    sleep 0.05
  done

  if [[ ! -s "$WAV" ]]; then
    hide_overlay
    log "WAV missing or empty: $WAV"
    notify-send "$APP_NAME" "No audio captured" || true
    echo "No audio captured."
    return
  fi

  log "WAV size: $(stat -c%s "$WAV" 2>/dev/null || echo '?') bytes"
  show_overlay transcribing

  ensure_server

  local reply transcription reply_ok=1
  reply="$(request_transcription 2>>"$LOG")" || reply_ok=0
  discard_audio

  if [[ "$reply_ok" != "1" ]]; then
    hide_overlay
    log "Failed talking to STT server"
    notify-send "$APP_NAME" "Could not reach speech server" || true
    echo "Transcription failed."
    return
  fi

  if ! transcription="$(printf '%s' "$reply" | extract_text 2>>"$LOG")"; then
    hide_overlay
    log "STT server returned an error"
    notify-send "$APP_NAME" "Speech transcription failed" || true
    echo "Transcription failed."
    return
  fi

  hide_overlay

  if [[ -z "$transcription" ]]; then
    log "No transcription text produced."
    echo "No transcription."
    return
  fi

  insert_text "$transcription"
}

case "${1:-}" in
  "")
    # flock owns the lock; -o prevents the recording/server/overlay children
    # from inheriting it after the toggle process exits. Do not queue presses:
    # a queued press could immediately stop a recording that just started.
    if flock -n -E 75 -o "$TOGGLE_LOCK" "$SCRIPT_DIR/hermeskey" --locked-toggle; then
      :
    else
      rc=$?
      if (( rc != 75 )); then
        exit "$rc"
      fi
      log "Hotkey ignored: recording start/stop or transcription still in progress"
      notify-send "$APP_NAME" "Still starting or transcribing; try again when ready." || true
    fi
    ;;
  --locked-toggle)
    # Only the outer flock invocation enters this path. Its lock spans the
    # whole transition, including transcription and text insertion.
    if [[ -f "$STATE" ]]; then
      record_stop_and_transcribe
    else
      record_start
      echo "Recording... press hotkey again to stop."
    fi
    ;;
  --help|-h)
    usage
    ;;
  --version)
    printf '%s\n' "$VERSION"
    ;;
  --doctor)
    run_doctor
    ;;
  --status)
    print_status
    ;;
  *)
    printf 'Unknown argument: %s\n\n' "$1" >&2
    usage >&2
    exit 1
    ;;
esac
